# ======================
# PRODUCTION ENVIRONMENT
# AWS EC2 + S3 + MongoDB Atlas
# ======================

# ======================
# SERVER CONFIGURATION
# ======================
PORT=5000
NODE_ENV=production

# ======================
# DATABASE
# ======================
# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://TU_USUARIO:TU_PASSWORD@TU_CLUSTER.mongodb.net/instagur_dev?retryWrites=true&w=majority

# ======================
# AUTHENTICATION
# ======================
# CRÍTICO: Genera un secreto fuerte y único para producción
# Comando: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=reemplaza_con_un_secreto_muy_largo_y_seguro_generado_con_crypto

# ======================
# FRONTEND
# ======================
# URL de tu frontend en producción - ACTUALIZAR CON IP DE EC2
FRONTEND_URL=http://TU_IP_EC2_AQUI

# Después de configurar dominio:
# FRONTEND_URL=https://tu-dominio.com

# ======================
# AWS S3 CONFIGURATION
# ======================
USE_S3=true
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=TU_AWS_ACCESS_KEY_AQUI
AWS_SECRET_ACCESS_KEY=TU_AWS_SECRET_KEY_AQUI
S3_BUCKET=tu-bucket-name
AWS_S3_BUCKET_NAME=tu-bucket-name

# ======================
# OPTIONAL: SSL/HTTPS
# ======================
# Si usas HTTPS con certificado propio
# SSL_CERT_PATH=/etc/ssl/certs/cert.pem
# SSL_KEY_PATH=/etc/ssl/private/key.pem

# ======================
# OPTIONAL: LOGGING
# ======================
# LOG_LEVEL=info
# LOG_FILE=/var/log/instagur/app.log

# ======================
# INSTRUCCIONES
# ======================
# 1. Crea MongoDB Atlas cluster: https://www.mongodb.com/cloud/atlas
# 2. Crea bucket S3 en AWS Console
# 3. Crea usuario IAM con permisos S3FullAccess
# 4. Genera JWT_SECRET seguro con crypto
# 5. Copia este archivo a .env en EC2
# 6. Completa TODOS los valores
# 7. NUNCA subas este archivo con valores reales a Git
